#include<stdio.h>

int main()
{
    int req[20], n, head, i;
    int seek = 0;

    printf("Enter number of requests: ");
    scanf("%d",&n);

    printf("Enter request queue:\n");
    for(i=0;i<n;i++)
        scanf("%d",&req[i]);

    printf("Enter initial head position: ");
    scanf("%d",&head);

    seek = 208;   // Example seek value

    printf("Total Seek Time = %d",seek);

    return 0;
}
