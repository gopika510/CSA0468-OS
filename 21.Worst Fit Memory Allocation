#include<stdio.h>

int main()
{
    int b[10], p[10], allocation[10];
    int m, n, i, j, worst;

    printf("Enter number of memory blocks: ");
    scanf("%d",&m);

    printf("Enter block sizes:\n");
    for(i=0;i<m;i++)
        scanf("%d",&b[i]);

    printf("Enter number of processes: ");
    scanf("%d",&n);

    printf("Enter process sizes:\n");
    for(i=0;i<n;i++)
        scanf("%d",&p[i]);

    for(i=0;i<n;i++)
        allocation[i]=-1;

    for(i=0;i<n;i++)
    {
        worst=-1;

        for(j=0;j<m;j++)
        {
            if(b[j]>=p[i])
            {
                if(worst==-1 || b[j]>b[worst])
                    worst=j;
            }
        }

        if(worst!=-1)
        {
            allocation[i]=worst;
            b[worst]-=p[i];
        }
    }

    printf("\nProcess No\tProcess Size\tBlock No\n");
    for(i=0;i<n;i++)
    {
        printf("%d\t\t%d\t\t",i+1,p[i]);

        if(allocation[i]!=-1)
            printf("%d\n",allocation[i]+1);
        else
            printf("Not Allocated\n");
    }

    return 0;
}
