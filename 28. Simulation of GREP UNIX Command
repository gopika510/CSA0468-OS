#include <stdio.h>
#include <string.h>

int main()
{
    char str[100][100];
    char word[50];
    int n, i;

    printf("Enter number of lines: ");
    scanf("%d", &n);
    getchar();

    printf("Enter lines:\n");

    for(i=0;i<n;i++)
        fgets(str[i],100,stdin);

    printf("Enter word to search: ");
    scanf("%s", word);

    printf("\nMatching Lines:\n");

    for(i=0;i<n;i++)
    {
        if(strstr(str[i], word))
            printf("%s", str[i]);
    }

    return 0;
}
