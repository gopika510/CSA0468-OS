#include<stdio.h>
#include<fcntl.h>
#include<unistd.h>
#include<sys/stat.h>
#include<dirent.h>

int main()
{
    int fd;
    struct stat st;
    DIR *d;
    struct dirent *dir;

    fd=open("test.txt",O_RDONLY);

    if(fd<0)
    {
        printf("File not found\n");
        return 0;
    }

    printf("File opened successfully\n");

    lseek(fd,0,SEEK_SET);

    fstat(fd,&st);

    printf("File Size = %ld bytes\n",st.st_size);

    d=opendir(".");

    printf("\nDirectory Contents:\n");

    while((dir=readdir(d))!=NULL)
    {
        printf("%s\n",dir->d_name);
    }

    closedir(d);
    close(fd);

    return 0;
}
