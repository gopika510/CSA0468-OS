#include <stdio.h>

int main()
{
    FILE *fp;
    char ch;

    fp = fopen("sample.txt", "w");

    fprintf(fp, "Operating System Lab");
    fclose(fp);

    fp = fopen("sample.txt", "r");

    printf("File Contents:\n");

    while((ch = fgetc(fp)) != EOF)
        printf("%c", ch);

    fclose(fp);

    return 0;
}
