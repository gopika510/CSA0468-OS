#include<stdio.h>

int main()
{
    int indexBlock, n, block[20];
    int i;

    printf("Enter Index Block: ");
    scanf("%d", &indexBlock);

    printf("Enter number of blocks: ");
    scanf("%d", &n);

    printf("Enter block numbers:\n");

    for(i = 0; i < n; i++)
        scanf("%d", &block[i]);

    printf("\nIndex Block: %d\n", indexBlock);

    printf("Allocated Blocks:\n");

    for(i = 0; i < n; i++)
        printf("%d ", block[i]);

    return 0;
}
